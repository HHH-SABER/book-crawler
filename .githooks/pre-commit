#!/bin/sh
# 小说爬虫 pre-commit 钩子 (2026-10-13, 需求 #1 工程化补齐)
#
# 作用: 在**暂存区**上跑两道快检 (合计 <10s), 挡住两类"不可逆/高代价"错误:
#   ① 红线: 真实站点域名/书名/用户数据文件进公开仓库 (本项目最高约束);
#   ② 静态: 未定义引用 (改了函数名漏改调用方)。
# 完整门禁 (1156 例单测约 50s) 仍由 CI 跑, 钩子只做"提交前快速拦截"。
#
# 安装 (一次性, 仓库本地配置, 不影响别人):
#   git config core.hooksPath .githooks
# 绕过 (仅紧急修复; 会在提交信息里留痕):
#   git commit --no-verify
#
# 为什么不做 CRLF 检查: 本项目文件惯例就是 CRLF (Windows), 全量阻断会误伤
# 存量文件; 而"用 LF 锚点去匹配 CRLF 文件"是工具使用问题, 钩子拦不住也不该拦。

PY=".runtime/python314/python.exe"
[ -x "$PY" ] || PY="python"

echo "[pre-commit] 红线扫描 (暂存区)…"
# ⚠️ 必须 -z: git 默认 core.quotepath=true 会把中文路径转义成 \350\204\232 这类
# 八进制假路径 (本项目路径含中文), 拿它去扫等于扫不存在的文件 ⇒ **假通过**。
# ⚠️ 不能走 `VAR=$(...)`: bash 的命令替换会**丢弃 NUL 字节**（"ignored null byte"
# 警告），多文件暂存时文件名会粘连成一个假路径 ⇒ 又是假通过。NUL 只能落**文件**。
# -z 输出 NUL 分隔且不做路径转义, 交给扫描器自己读才能保住每个文件名。
#
# ⚠️ 不用 xargs (2026-11-10 修): xargs 按 "ARG_MAX 减环境变量体积" 估算还能不能
#   exec, 会话 env 涨到 ~30KB (234 个变量) 时就报 `environment is too large for
#   exec` 并非 0 退出 —— 于是被下面当成"红线命中"**假拦提交**, 而内容其实是干净的,
#   报错里也没有一个字指向 env, 最容易被误判成真要加排除项、或者顺手 --no-verify。
#   改成把 -z 清单写临时文件、由扫描器 --files-from 读取, 与 env 体积无关。
# ⚠️ shell 变量名必须 ASCII: `_清单=...` 里的中文不是合法标识符, sh 会把整行当**命令名**
#   去执行并报 "No such file or directory" —— 而 `sh -n` 语法检查照样通过 (2026-11-10 实踩,
#   同一笔改动里踩了两次)。改钩子后必须**真跑一次提交**, 不能只做语法检查。
_LIST=".git/_precommit_files.$$"   # 放 .git/（hook 的 cwd 恒为工作树根）: 不依赖 TMPDIR 的平台形态（Windows 下是带盘符路径，安全删除垫片会拒），也不会被清理工具扫走
if ! git diff --cached --name-only -z --diff-filter=ACM > "$_LIST"; then
        echo "[pre-commit] ❌ 生成暂存清单失败, 提交被阻止 (不进 --no-verify)。"
        exit 1
fi
"$PY" 脚本/红线扫描.py --files-from "$_LIST"
_RC=$?
rm -f "$_LIST"
if [ $_RC -ne 0 ]; then
        echo "------------------------------------------------------------"
        echo "[pre-commit] ❌ 红线命中 (命中清单见上方 ⚠ 行), 提交被阻止。"
        echo "处置: ①改成代号/占位; ②确属误报 → 在 脚本/红线扫描.py 加排除项"
        echo "      并注明理由; ③紧急情况下 git commit --no-verify (留痕)。"
        exit 1
fi

echo "[pre-commit] 阶段覆盖检查 (S1)…"
if ! "$PY" 脚本/检查阶段覆盖.py --严格 > /tmp/_precommit_stages.log 2>&1; then
    tail -15 /tmp/_precommit_stages.log
    echo "[pre-commit] ❌ 适配器声明了代码里不存在的阶段, 提交被阻止。"
    echo "      处置: 适配器里的阶段名改回代码里的写法（见 脚本/检查阶段覆盖.py 输出）"
    exit 1
fi

echo "[pre-commit] 静态引用检查…"
if ! "$PY" 脚本/check_undefined_refs.py > /tmp/_precommit_static.log 2>&1; then
    tail -15 /tmp/_precommit_static.log
    echo "[pre-commit] ❌ 静态检查未过, 提交被阻止。"
    exit 1
fi

# 规则轨迹 (S1 第三步, 2026-10-26): 改 爬虫.py / 适配器 / 站点表 时, 站点策略的
# **决策轨迹**必须零变化 —— 这是"拆分/重构"的安全网 (静态检查看不出来的分支变化)。
# 快照在 .runtime/ (gitignored); 新机器/公开形态没有快照 ⇒ 跳过, 不阻断提交。
if [ -f ".runtime/规则轨迹.json" ]; then
    echo "[pre-commit] 规则轨迹对比 (S1)…"
    if ! "$PY" 脚本/规则轨迹对照.py --对比 > /tmp/_precommit_trace.log 2>&1; then
        tail -18 /tmp/_precommit_trace.log
        echo "[pre-commit] ❌ 站点策略决策轨迹与快照不一致, 提交被阻止。"
        echo "      有意改动 ⇒ 重跑 脚本/规则轨迹对照.py 更新快照后重新提交 (快照不入库)"
        exit 1
    fi
else
    echo "[pre-commit] 规则轨迹: 无快照, 跳过 (新机器/公开形态正常)"
fi

echo "[pre-commit] ✅ 通过"
exit 0
